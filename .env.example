# Settle environment. Fill the blank values. Never commit this file.

# --- Telegram (from @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Pre-generated random secret. Sent to Telegram via setWebhook secret_token, checked on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram numeric user IDs allowed to use the bot (protects Meta credits). Get yours from @userinfobot.
ALLOWED_TELEGRAM_IDS=
# Launch switch: false opens the bot to everyone, but only works while BILLING_ENABLED=true (see lib/telegram/access.ts).
ALLOWLIST_ENABLED=true

# --- Meta Model API (dev.meta.ai -> API keys) ---
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Optional faster model for text only messages. Blank means "use META_MODEL".
META_TEXT_MODEL=
# Optional reasoning effort for text only calls: minimal, low or medium. Blank means "low".
META_TEXT_EFFORT=
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# Hard stop for live AI spend per day, in USD (tracked in ai_calls table)
META_DAILY_BUDGET_USD=10

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
# Secret key (sb_secret_...) or legacy service_role key. Server-only, never exposed to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=uploads
# Only needed for running migrations with the Supabase CLI (Project Settings -> Database -> connection string)
SUPABASE_DB_URL=

# --- App ---
# Pre-generated random secret for signing dashboard session cookies.
SESSION_SECRET=
# Local: http://localhost:3000 . Production: your Vercel URL (used in magic links and setWebhook).
APP_BASE_URL=http://localhost:3000

# --- Billing (post-hackathon) ---
# Keep false until the launch switch (T22). With false everyone is treated as Pro and nothing is blocked.
BILLING_ENABLED=false

# --- Stripe (web payments, T21, test mode first) ---
# All optional: with any of these blank the dashboard treats paid plans as not open yet.
# Secret key from dashboard.stripe.com/test/apikeys first; move to live keys later without code changes.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) for the /api/stripe/webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Recurring Pro prices: one for the monthly plan, one for the yearly plan (dashboard.stripe.com/test/products).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# One-time yearly price for the PayNow option. Leave blank to hide the PayNow button on /billing.
STRIPE_PRICE_PRO_YEARLY_PAYNOW=
# Stripe Managed Payments: Stripe becomes seller of record for web card payments and handles tax. Default false; read docs/STRIPE-MANAGED-PAYMENTS.md and finish its checklist before setting true. With true the PayNow option is hidden.
STRIPE_MANAGED_PAYMENTS=false

# --- Legal pages (content/legal/*.md tokens) ---
# All optional: blank values turn into visible [[MISSING: VAR]] markers on the legal pages, and scripts/check-legal.ts reports them. Fill all four before launch.
# Business name, as registered with ACRA, shown on /terms and /privacy.
LEGAL_BUSINESS_NAME=
# UEN: the Singapore business registration number issued by ACRA.
LEGAL_BUSINESS_UEN=
# Support inbox shown on every legal page and used for privacy and refund requests.
LEGAL_SUPPORT_EMAIL=
# Supabase project region as it should read in the privacy notice (e.g. ap-southeast-1).
LEGAL_SUPABASE_REGION=

# --- Google Calendar sync (Pro only, library layer) ---
# OAuth client id from Google Cloud console. Redirect URI: https://settlenotes.com/api/calendar/callback.
GOOGLE_CLIENT_ID=
# OAuth client secret from Google Cloud console. Server only, never logged.
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 encoded. Key for AES-256-GCM refresh token encryption.
CALENDAR_TOKEN_KEY=
# UI switch. Blank or false keeps every calendar surface hidden until switched on.
CALENDAR_SYNC_ENABLED=
# Shared secret guarding the calendar reconcile cron route.
CALENDAR_CRON_SECRET=
