# Settle environment. Fill the blank values. Never commit this file.

# --- Telegram (from @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Pre-generated random secret. Sent to Telegram via setWebhook secret_token, checked on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram numeric user IDs allowed to use the bot (protects Meta credits). Get yours from @userinfobot.
ALLOWED_TELEGRAM_IDS=

# --- Meta Model API (dev.meta.ai -> API keys) ---
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# Hard stop for live AI spend per day, in USD (tracked in ai_calls table)
META_DAILY_BUDGET_USD=10

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
# Secret key (sb_secret_...) or legacy service_role key. Server-only, never exposed to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=uploads
# Only needed for running migrations with the Supabase CLI (Project Settings -> Database -> connection string)
SUPABASE_DB_URL=

# --- App ---
# Pre-generated random secret for signing dashboard session cookies.
SESSION_SECRET=
# Local: http://localhost:3000 . Production: your Vercel URL (used in magic links and setWebhook).
APP_BASE_URL=http://localhost:3000
